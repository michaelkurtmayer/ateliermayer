---
// One large image at a time with thin arrows at the sides (desktop);
// on phones the images are simply stacked, edge to edge.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /* the home page: one image filling the window below the header, edge to edge */
  fullBleed?: boolean;
  items: { src: ImageMetadata; src2x?: ImageMetadata; text?: string; caption?: string; scale?: string; credit?: string; alt: string }[];
}

const { lang, items, fullBleed = false } = Astro.props;
const t = useTranslations(lang);

// Drawings (items with a 2x file) are served as exported, never recompressed:
// the browser picks the 1x or the 2x file for the width the drawing is shown at.
// Desktop: inside a 68vw × (68vw × 2/3) frame, so narrower drawings show narrower.
// A slide of text: paragraphs on blank lines, line breaks kept, *italics*
const textHtml = (text: string) =>
  text
    .trim()
    .split(/\n\s*\n/)
    .map((para) => {
      const safe = para.trim().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return `<p>${safe.replace(/\*([^*]+)\*/g, '<em>$1</em>').replace(/\n/g, '<br />')}</p>`;
    })
    .join('');

// A credit under a caption: line breaks kept, *titles* in italics
const creditHtml = (text: string) =>
  text
    .trim()
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
    .replace(/\n/g, '<br />');

const drawingSizes = (img: ImageMetadata) => {
  const vw = Math.min(68, (68 * (img.width / img.height)) / 1.5);
  return `(max-width: 720px) 100vw, ${vw.toFixed(1)}vw`;
};

// Renders (the cover and the other perspectives): copies up to the render's
// own full width, at quality 90 (the default, 80, looked soft on the cover).
const renderWidths = (img: ImageMetadata) => [
  ...[600, 900, 1200, 1600, 2000].filter((w) => w < img.width),
  img.width,
];

// The home photo. On phones it fills the screen below the 50 px header and is
// cropped at the sides, so it is shown much wider than the screen: tell the
// browser that width, or it picks a copy a third of the size it needs.
const bleedSizes = (img: ImageMetadata) =>
  `(max-width: 720px) calc((100vh - 50px) * ${(img.width / img.height).toFixed(3)}), 100vw`;
---

<div class:list={['slideshow', { 'slideshow-bleed': fullBleed }]} data-slideshow>
  <div class="slides" tabindex="0">
    {
      items.map((item, i) => (
        <figure class="slide">
          {item.text ? (
            <div class="slide-text" lang="en">
              <div class="slide-text-column" set:html={textHtml(item.text)} />
            </div>
          ) : item.src2x ? (
            <img
              src={item.src.src}
              srcset={`${item.src.src} ${item.src.width}w, ${item.src2x.src} ${item.src2x.width}w`}
              sizes={drawingSizes(item.src)}
              width={item.src.width}
              height={item.src.height}
              alt={item.alt}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ) : (
            <Image
              src={item.src}
              alt={item.alt}
              widths={renderWidths(item.src)}
              sizes={fullBleed ? bleedSizes(item.src) : '(max-width: 720px) 100vw, 68vw'}
              quality={90}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          )}
          {item.caption && (
            <figcaption class="slide-caption">
              {item.caption}
              {item.scale && (
                <>
                  <br />
                  {item.scale}
                </>
              )}
              {item.credit && (
                <>
                  <br />
                  <span set:html={creditHtml(item.credit)} />
                </>
              )}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>
  {
    items.length > 1 && (
      <>
        <button class="slide-arrow slide-prev" type="button" aria-label={t('slides.previous')}>
          <svg viewBox="0 0 20 40" aria-hidden="true">
            <path d="M17 2L3 20l14 18" />
          </svg>
        </button>
        <button class="slide-arrow slide-next" type="button" aria-label={t('slides.next')}>
          <svg viewBox="0 0 20 40" aria-hidden="true">
            <path d="M3 2l14 18L3 38" />
          </svg>
        </button>
      </>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((show) => {
    const track = show.querySelector<HTMLElement>('.slides');
    if (!track) return;
    const count = track.children.length;
    const index = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => {
      const next = (i + count) % count; // wraps around at both ends
      track.scrollTo({ left: next * track.clientWidth, behavior: 'smooth' });
    };
    // A link ending in #slide-N (from the Work page thumbnails) opens image N
    const match = location.hash.match(/^#slide-(\d+)$/);
    const target = match ? track.children[Number(match[1])] : null;
    if (target instanceof HTMLElement) {
      if (getComputedStyle(track).display === 'flex') {
        track.scrollLeft = Number(match![1]) * track.clientWidth; // desktop: that slide
      } else {
        target.scrollIntoView({ block: 'start' }); // phones: scroll down to it
      }
    }
    show.querySelector('.slide-prev')?.addEventListener('click', () => go(index() - 1));
    show.querySelector('.slide-next')?.addEventListener('click', () => go(index() + 1));
    document.addEventListener('keydown', (e) => {
      if (getComputedStyle(track).display !== 'flex') return; // phones: no slideshow
      if (e.key === 'ArrowLeft') go(index() - 1);
      if (e.key === 'ArrowRight') go(index() + 1);
    });
  });
</script>
