---
import LangSwitch from './LangSwitch.astro';
import { localize, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../site';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
const links = [
  { href: '/work/', label: t('nav.work') },
  { href: '/about/', label: t('nav.about') },
];
---

<header class="site-header">
  <a class="wordmark" href={localize(lang, '/')}>{site.name}</a>
  <nav class="nav" aria-label={site.name}>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={localize(lang, l.href)} aria-current={path.startsWith(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <LangSwitch lang={lang} path={path} class="header-langs" />
</header>
