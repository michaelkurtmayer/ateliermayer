---
import { languageNames, langs, localize, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  class?: string;
  /** Show only the other languages (the current one is left out). */
  others?: boolean;
}

const { lang, path, class: className, others = false } = Astro.props;
const t = useTranslations(lang);
const shown = others ? langs.filter((l) => l !== lang) : langs;
---

<ul class:list={['langs', className]} aria-label={t('nav.language')}>
  {
    shown.map((l) => (
      <li>
        <a
          href={localize(l, path)}
          hreflang={l}
          lang={l}
          title={languageNames[l]}
          aria-current={l === lang ? 'true' : undefined}
        >
          {l.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>
