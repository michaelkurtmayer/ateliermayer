---
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { langs, localize, stripLang, useTranslations, withBase, type Lang } from '../i18n/ui';
import { site } from '../site';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  ogImage?: string;
  alternates?: boolean;
}

const { lang, title, description, ogImage, alternates = true } = Astro.props;
const t = useTranslations(lang);
// Language links point at the same page in the other language
// (or at each home page when there is no translated equivalent, e.g. 404).
const path = alternates ? stripLang(Astro.url.pathname) : '/';
const fullTitle = title ? `${title} — ${site.name}` : site.name;
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogLocale: Record<Lang, string> = { fr: 'fr_CA', en: 'en_CA', de: 'de_DE' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    {
      alternates && (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => (
            <link rel="alternate" hreflang={l} href={new URL(localize(l, path), Astro.site)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(withBase('/'), Astro.site)} />
        </>
      )
    }
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <script is:inline>
      try { localStorage.setItem('lang', document.documentElement.lang); } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
