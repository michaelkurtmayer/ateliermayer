---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import studio from '../../../about/studio.jpg';
import Base from '../../layouts/Base.astro';
import { langPaths, useTranslations, type Lang } from '../../i18n/ui';
import { site } from '../../site';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const entry = await getEntry('about', lang);
if (!entry) throw new Error(`Missing about/${lang}.md`);
const { Content } = await render(entry);

// Description of the photo for screen readers (translated with DeepL)
const photoAlt: Record<Lang, string> = { fr: 'En studio', en: 'In the studio', de: 'Im Studio' };

const social = [
  site.instagram && { text: 'Instagram', href: site.instagram },
  site.linkedin && { text: 'LinkedIn', href: site.linkedin },
].filter(Boolean) as { text: string; href: string }[];
---

<Base lang={lang} title={t('about.title')}>
  <div class="text-page">
    <h1 class="visually-hidden">{t('about.title')}</h1>
    <aside class="side-column" aria-label={t('about.contact')}>
      {
        (site.city || site.phone) && (
          <p>
            {site.city}
            {site.city && site.phone && <br />}
            {site.phone && <a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a>}
          </p>
        )
      }
      {
        site.contacts.map((c) => (
          <p>
            {c.title[lang]}
            <br />
            <a href={`mailto:${c.email}`}>{c.email}</a>
            {c.note && (
              <>
                <br />
                {c.note[lang]}
              </>
            )}
          </p>
        ))
      }
      {
        social.length > 0 && (
          <p>
            {social.map((s, i) => (
              <>
                {i > 0 && <br />}
                <a href={s.href}>{s.text}</a>
              </>
            ))}
          </p>
        )
      }
    </aside>
    <div class="page-column">
      <figure class="page-image">
        <Image
          src={studio}
          alt={photoAlt[lang]}
          widths={[600, 900, 1200, 1600]}
          sizes="(max-width: 720px) 100vw, 44vw"
          loading="eager"
        />
      </figure>
      <div class="prose">
        <Content />
      </div>
    </div>
  </div>
</Base>
