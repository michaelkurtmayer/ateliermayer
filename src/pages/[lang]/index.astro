---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Slideshow from '../../components/Slideshow.astro';
import { getPublishedProjects } from '../../lib/projects';
import { langPaths, type Lang } from '../../i18n/ui';
import { site } from '../../site';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const projects = await getPublishedProjects();

// Every image of every project (cover first, then the page's images),
// interleaved project by project.
const perProject = projects.map((p) => [
  { src: p.data.cover!, alt: p.data.title },
  ...p.data.images.map((img) => ({ src: img.src, src2x: img.src2x, alt: img.caption?.[lang] ?? p.data.title })),
]);
const longest = Math.max(...perProject.map((list) => list.length));
const items = [];
for (let i = 0; i < longest; i++) {
  for (const list of perProject) if (list[i]) items.push(list[i]);
}

const og = await getImage({ src: projects[0].data.cover!, width: 1200, format: 'jpg' });
---

<Base lang={lang} ogImage={og.src}>
  <h1 class="visually-hidden">{site.name}</h1>
  <Slideshow lang={lang} items={items} />
</Base>
