---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/projects';
import { langPaths, localize, type Lang } from '../../i18n/ui';
import { site } from '../../site';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const projects = await getProjects();
const og = await getImage({ src: projects[0].data.cover, width: 1200, format: 'jpg' });
---

<Base lang={lang} ogImage={og.src}>
  <section class="home">
    <h1 class="visually-hidden">{site.name}</h1>
    <ul class="home-projects">
      {
        projects.map((p, i) => (
          <li class="home-project">
            <a href={localize(lang, `/work/${p.id}/`)}>
              <Image
                src={p.data.cover}
                alt={p.data.title}
                widths={[480, 720, 960, 1200, 1600]}
                sizes="(max-width: 720px) 100vw, 33vw"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
              <span class="home-text">
                <span>{p.data.title}</span>
                <span class="label">{p.data.programme[lang]}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
