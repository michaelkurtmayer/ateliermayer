---
import Base from '../../../layouts/Base.astro';
import Slideshow from '../../../components/Slideshow.astro';
import { getPublishedProjects } from '../../../lib/projects';
import { langs, paragraphs, useTranslations, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return langs.flatMap((lang) =>
    projects.map((project) => ({
      params: { lang, slug: project.id },
      props: { project },
    })),
  );
}

const { project } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const d = project.data;

const items = [
  { src: d.cover!, alt: d.title },
  ...d.images.map((img) => ({ src: img.src, src2x: img.src2x, alt: img.caption?.[lang] ?? d.title })),
];

// For now the project pages show only the images. The summary, the facts
// (type, location, year, status, context) and the text stay in each
// project's index.md; set SHOW_TEXT to true to show them again.
const SHOW_TEXT = false;

const facts = [
  [t('meta.type'), d.type[lang]],
  [t('meta.location'), d.location],
  [t('meta.year'), d.year],
  [t('meta.status'), d.status[lang]],
  [t('meta.context'), d.context[lang]],
];
---

<Base lang={lang} title={d.title} description={d.summary[lang]}>
  <article class="project">
    <h1 class="visually-hidden">{d.title}</h1>
    <Slideshow lang={lang} items={items} />
    {
      SHOW_TEXT && (
        <div class="text-column">
          <p>{d.summary[lang]}</p>
          <p>
            {facts.map(([label, value], i) => (
              <>
                {label}: {value}
                {i < facts.length - 1 && <br />}
              </>
            ))}
          </p>
          {paragraphs(d.text[lang]).map((p) => <p>{p}</p>)}
        </div>
      )
    }
  </article>
</Base>
