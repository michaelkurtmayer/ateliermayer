---
import Base from '../../../layouts/Base.astro';
import { getProjects } from '../../../lib/projects';
import { langPaths, localize, useTranslations, type Lang } from '../../../i18n/ui';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const projects = await getProjects();
---

<Base lang={lang} title={t('work.title')}>
  <h1 class="visually-hidden">{t('work.title')}</h1>
  <ul class="work-list">
    {
      projects.map((p) => (
        <li class="work-row">
          {p.data.cover ? (
            <a href={localize(lang, `/work/${p.id}/`)}>{p.data.title}</a>
          ) : (
            <span>{p.data.title}</span>
          )}
          <span>{p.data.type[lang]}</span>
          <span>{p.data.year}</span>
        </li>
      ))
    }
  </ul>
</Base>
